ALERTSIFY_BASE_URL=https://alertsify.com
# Paper and live Alertsify user ids (comma-separated; same cookie/session for all)
ALERTSIFY_USER_ID_PAPER=user_one,user_two
ALERTSIFY_USER_ID_LIVE=user_three
# Legacy: single list + global mode (deprecated when split lists are set)
# ALERTSIFY_USER_ID=user_one,user_two
# TRADING_MODE=paper
# Optional: sent verbatim as the Authorization header (e.g. Bearer <token>)
# ALERTSIFY_AUTHORIZATION=Bearer ...
# Optional: paste the ENTIRE Cookie header from DevTools/curl (often TWO cookies:
#   Fe26.2*...~2; alertsify.session=Fe26.2*...
# ). If you only set alertsify.session=... with the first Fe26 blob, Alertsify returns 401.
# If the value contains #, wrap the entire value in double quotes.
# ALERTSIFY_COOKIE="Fe26.2*...~2; alertsify.session=Fe26.2*..."
# Optional: override User-Agent for Alertsify only (default mimics curl, matching curl --location usage)
# ALERTSIFY_USER_AGENT=Mozilla/5.0 ...

POLL_INTERVAL_MS=60000
# Mon–Fri only, US Eastern wall clock (America/New_York = EST/EDT). Outside session the process sleeps until the next open.
POLL_MARKET_HOURS_ONLY=true
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00

LIBSQL_URL=file:./local.db
LIBSQL_AUTH_TOKEN=

TRADIER_PAPER_API_KEY=
TRADIER_LIVE_API_KEY=
TRADIER_PAPER_ACCOUNT_ID=
TRADIER_LIVE_ACCOUNT_ID=

TRADIER_OPTION_SIDE=buy_to_open
TRADIER_OPTION_CLOSE_SIDE=sell_to_close
TRADIER_ORDER_TYPE=market
TRADIER_ORDER_DURATION=day
# TRADIER_LIMIT_PRICE=1.25

TRADIER_PREVIEW_ONLY=false

# Max premium dollars per open trade; order qty = min(alertsify qty, floor(TRADE_MAX_CAPITAL / (premium * 100)))
TRADE_MAX_CAPITAL=2000

NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=your-ntfy-topic

# Live trade performance dashboard (alertsify-dashboard)
# Leave DASHBOARD_API_KEY empty for local dev without auth
DASHBOARD_API_KEY=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_CORS_ORIGIN=http://127.0.0.1:5173
# Optional override when UI assets live outside default search paths
# DASHBOARD_DIST_DIR=/app/src/alertsify_scraper/dashboard/static
